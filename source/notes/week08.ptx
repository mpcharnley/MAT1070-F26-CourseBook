            <title>Graphs of Quadratics</title>
            
<example workspace="4in">
    <statement>
        <p>
            Draw the graphs of <m>x^2</m>, <m>(x-3)^2</m>, <m>x^2 + 1</m>, and <m>-x^2</m>.
        </p>
    </statement>

</example>

        </paragraphs>
    </page>

    <page>
        
        <p component="b" workspace="4in">
