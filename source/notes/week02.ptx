  </page>
  <page>
    <example>
      <introduction>
        <p>
          An electric company charges a bill of $30 plus $0.50 per kWh used for the first 200 kWh. After that, the rate changes.
        </p>
      </introduction>
      <task workspace="3in">
        <statement>
          <p>
            Determine a function for the amount that the electric company will charge for a bill of <m>x</m> kWh.
          </p>
        </statement>
      </task>
      <task workspace="1in">
        <statement>
          <p>
            What is the domain of this function?
          </p>
        </statement>
      </task>
      <task workspace="2in">
        <statement>
          <p>
            How much will they charge for a house that uses 120 kWh in a month?
          </p>
        </statement>
      </task>
    </example>
  </page>
