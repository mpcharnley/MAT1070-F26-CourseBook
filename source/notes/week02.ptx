    </introduction>
    <task>
      <statement>
        <p>
          Compute the average rate of change (in dollars per month) between January 1, 2019 and January 1, 2024.
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          Compute the average rate of change (in dollars per month) between January 1, 2019 and January 1, 2021.
        </p>
      </statement>
