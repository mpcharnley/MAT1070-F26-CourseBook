<page>
    <example>
        <introduction>
            <p>
                Consider the function <m>f(x)</m> defined as <md>
                    f(x) = \begin{cases}
                        \frac{x^2 - 9}{x+3} \amp x &lt; -3 \\
                        3 \amp x=-3 \\
                        -x-1  \amp -3 &lt; x \leq 1 \\
                        3x-5 \amp x &gt; 1
                    \end{cases}
                </md>.
            </p>
        </introduction>
        <task workspace="2in">
            <statement>
                <p>
                    Evalute <m>f(-5)</m>, <m>f(-3)</m>, <m>f(0)</m>, and <m>f(1)</m>.
                </p>
            </statement>
    
        </task>
        <task>
            <statement>
                <p>
                    Sketch a graph of the function <m>f(x)</m>.
                </p>
