<page>
    <example>
        <introduction>
            <p>
                Consider the function <m>f(x)</m> defined as <md>
                    f(x) = \begin{cases}
                        |x|+2 \amp x &lt; -1 \\
                        1 - x \amp -1 \leq x &lt; 2 \\
                        2x-5 \amp x \geq 2
                    \end{cases}
                </md>.
            </p>
        </introduction>
        <task workspace="2in">
            <statement>
                <p>
                    Evalute <m>f(-2)</m>, <m>f(-1)</m>, <m>f(2)</m>, and <m>f(5)</m>.
                </p>
            </statement>
    
        </task>
        <task>
            <statement>
                <p>
                    Sketch a graph of the function <m>f(x)</m>.
                </p>
