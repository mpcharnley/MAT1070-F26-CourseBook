  <!-- Exercises start here. -->
  <exercise>
    <statement>
      <p>
        [2] What does the graph of an equation represent?
      </p>
    </statement>
    <solution>
      <p>
        The set of all solution points to an equation.
      </p>
    </solution>
  </exercise>

  <exercise>
    <introduction>
      <p>
        [9] Consider the equation <m>2x+3y=12</m>. <em>Fully explain</em> each method and your solution. 
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          Graph the equation using any two points.
        </p>
      </statement>
      <solution>
        <image width="60%">
  <prefigure xmlns="https://prefigure.org"
             label="wksht-graphing-lines-points">
    <xi:include href="../../prefigure/graphing-equations-line-points.xml" />
  </prefigure>
  <shortdescription>The plot of a straight line that goes through the points (0,4) and (3,2).</shortdescription>
</image>
      </solution>
    </task>
    <task>
      <statement>
        <p>
          Graph the equation using intercepts.
        </p>
      </statement>
      <solution>
        <image width="60%">
  <prefigure xmlns="https://prefigure.org"
             label="wksht-graphing-lines-inter">
    <xi:include href="../../prefigure/graphing-equations-line-intercepts.xml" />
  </prefigure>
  <shortdescription>The plot of a straight line that goes through the points (0,4) and (6,0).</shortdescription>
</image>
      </solution>
    </task>
    <task>
      <statement>
        <p>
          Graph the equation using the slope and <m>y</m>-intercept.
        </p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        [2] Which of the three ways above is your preferred method when you need to graph a <em>linear</em> equation? Why?
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        [3] Graph the equation <m>y = 2x^2 - 4x + 5</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        [4] Explain the method you used to graph your <em>non-linear</em> equation and why another method would not be appropriate. (For example: why would graphing just two points not work?)
      </p>
    </statement>
  </exercise>

</worksheet>
