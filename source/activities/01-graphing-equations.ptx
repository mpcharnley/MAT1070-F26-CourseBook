  <!-- Exercises start here. -->
  <exercise workspace="2in">
    <statement>
      <p>
        [2] What does the graph of an equation represent?
      </p>
    </statement>
    <solution>
      <p>
        The set of all solutions points to an equation.
      </p>
    </solution>
  </exercise>

  <exercise>
    <introduction>
      <p>
        [9] Consider the equation <m>2x+3y=12</m>.
      </p>
    </introduction>
    <task workspace="4in">
      <statement>
        <p>
          Graph the equation using any two points.
        </p>
      </statement>
      <solution>
        <image width="60%">
  <prefigure xmlns="https://prefigure.org"
             label="wksht-graphing-lines-points">
    <xi:include href="../../prefigure/graphing-equations-line-points.xml" />
  </prefigure>
</image>
      </solution>
    </task>
    <task workspace="4in">
      <statement>
        <p>
          Graph the equation using intercepts.
        </p>
      </statement>
      <solution>
        <image width="60%">
  <prefigure xmlns="https://prefigure.org"
             label="wksht-graphing-lines-inter">
    <xi:include href="../../prefigure/graphing-equations-line-intercepts.xml" />
  </prefigure>
</image>
      </solution>
    </task>
    <task workspace="4in">
      <statement>
        <p>
          Graph the equation using the slope and <m>y</m>-intercept.
        </p>
      </statement>
    </task>
    <conclusion>
      <p>
        <em>Fully explain</em> each method and your solution. 
      </p>
    </conclusion>
  </exercise>

</worksheet>
