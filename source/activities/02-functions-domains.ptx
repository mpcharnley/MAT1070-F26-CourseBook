  </introduction>
<page>
  <paragraphs>
    <title>In-Class Exercises (not for submission)</title>
    <exercise>
      <introduction>
        <p>
          Consider the relation
          <md>
            \{(-5,5), (-4, 4), (3, -3), (1,1)\}
          </md>.
        </p>
      </introduction>
      <task>
        <statement>
          <p>
            Is this a function? Justify your answer.
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            What is its domain?
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            What is its range?
          </p>
        </statement>
      </task>
    </exercise>
  </paragraphs>
<exercise>
  <introduction>
    <p>
      Given that <m>f(x) = x^2 - 3x - 4</m>, find each of the following.
    </p>
  </introduction>
  <task>
    <statement>
      <p>
        <m>f(-2)</m>
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m>f(a+5)</m>
      </p>
    </statement>
  </task>
</exercise>
<exercise>
  <introduction>
    <p>
      Find the domain of each function.
    </p>
  </introduction>
  <task>
    <statement>
      <p>
        <m>\displaystyle f(x) = \frac{4}{x-2}</m>.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m>\displaystyle f(x) = \sqrt[3]{4-x}</m>.
      </p>
    </statement>
  </task>
  <task>
    <statement>
      <p>
        <m>\displaystyle \frac{x-3}{x^2 - 7x}</m>.
      </p>
    </statement>
  </task>
</exercise>
</page>

<page>
  <paragraphs>
    <title>Homework Exercises (for submission)</title>
    
    <exercise>
      <introduction>
        <p>
          Given that <md>
            f(x) = \frac{-3+x}{2x-1}
          </md>, find each of the following.         
        </p>
      </introduction>
      <task>
        <statement>
          <p>
            <m>f(-1)</m>
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            <m>f\left(\frac{1}{2}\right)</m>
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            <m>f(x+h)</m>.
          </p>
        </statement>
      </task>
    </exercise>
    <example>
      <introduction>
        <p>
          Find the domain of each function.
        </p>
      </introduction>
      <task>
        <statement>
          <p>
            <m>\displaystyle f(x) = \frac{x^2}{x-3}</m>
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            <m>\displaystyle f(x) = \frac{3x+5}{x^2 - 2x - 8}</m>.
          </p>
        </statement>
      </task>
    </example>
  </paragraphs>
</page>

</worksheet>
