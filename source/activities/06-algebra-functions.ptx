<worksheet component = "cur" xml:id = "wksht-alg-functions" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Algebra of Functions</title>

    <introduction>
        <p>
            <ul>
                <li><title>Dates</title>
