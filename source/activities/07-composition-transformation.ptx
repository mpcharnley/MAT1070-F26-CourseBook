<page>

<paragraphs>
    <title>In-Class Work</title>
    <p>
        These problems were completed during the in-class activity.
    </p>

<exercise>
    <introduction>
        <p>
            Given that <m>f(x) = x^2 +2</m>, <m>g(x) = 2x-5</m>, and <m>h(x) = 3x^2 + 4x - 2</m>, find each of the following.
        </p>
    </introduction>
    <task>
        <statement>
            <p>
                <m>(f\circ g)(1)</m>
            </p>
        </statement>
        <solution component="a">
            <p>
                <m>11</m>
            </p>
        </solution>
    </task>
    <task>
        <statement>
            <p>
                <m>(g \circ h)(-3)</m>
            </p>
        </statement>
        <solution component="a">
            <p>
                <m>21</m>
            </p>
        </solution>
    </task>
    <task>
        <statement>
            <p>
                <m>(h\circ f)(2)</m>
            </p>
        </statement>
        <solution component="a">
            <p>
                <m>130</m>
            </p>
        </solution>
    </task>
    <task>
        <statement>
            <p>
                <m>(g \circ g)(x)</m> 
            </p>
        </statement>
        <solution component="a">
            <p>
                <m>4x-15</m>
            </p>
        </solution>
    </task>
    <task>
        <statement>
            <p>
                <m>(h\circ g)(x)</m>
            </p>
        </statement>
        <solution component="a">
            <p>
                <m>12x^2 - 52x + 53</m>
            </p>
        </solution>
    </task>
</exercise>

<exercise>
    <statement>
        <p>
            Write an equation for a function that has the shape of <m>y = x^2</m> but is reflected over the <m>x</m>-axis and it shifted to the right by <m>3</m> units.
        </p>
    </statement>
    <solution component="a">
        <p>
            <m>y = -(x-3)^2</m>
        </p>
    </solution>
</exercise>

