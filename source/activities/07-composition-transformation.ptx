    <exercise>
        <statement>
            <p>
                Write an equation for a function that has the shape of <m>y = |x|</m> but is twice as tall and is shifted to the left by 3 units.
            </p>
        </statement>
        <solution component="a">
            <p>
                <m>y = 2|x+3|</m>
            </p>
        </solution>
    </exercise>


