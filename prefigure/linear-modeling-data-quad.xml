<diagram xmlns="https://prefigure.org" dimensions="(300,300)"
         margins="(30,30,5,5)">
  <read name="df" filename="data/linear-modeling-data-quad.data"/>
  <definition>x=df['x']</definition>
  <definition>y=df['y']</definition>
  <definition>points=zip_lists(x, y)</definition>
  
  <coordinates bbox="[0,0,10,10]">
    <grid-axes>
      <xlabel alignment="sw" offset="(0,0)">x</xlabel>
      <ylabel alignment="se">y</ylabel>
    </grid-axes>

    <scatter points="points" fill="blue"/>

  </coordinates>
</diagram>