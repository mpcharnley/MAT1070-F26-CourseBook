<diagram xmlns="https://prefigure.org" dimensions="(300,300)"
         margins="(30,30,5,5)">
  <read name="df" filename="Chegg_stock_price.data" string-columns="['Date']"/>
  <definition>x=df['Mth']</definition>
  <definition>y=df['Price']</definition>
  <definition>points=zip_lists(x, y)</definition>
  
  <coordinates bbox="[0,0,75,100]">
    <grid-axes>
      <xlabel alignment="sw" offset="(0,0)">Months</xlabel>
      <ylabel alignment="se">Stock Price</ylabel>
    </grid-axes>

    <scatter points="points" fill="blue"/>

  </coordinates>
</diagram>