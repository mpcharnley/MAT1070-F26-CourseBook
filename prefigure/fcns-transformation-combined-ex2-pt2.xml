<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> f(x)=(2*x)^2</definition>
  <coordinates bbox="[-5, -3, 5, 5]">
    <grid-axes xlabel="x" ylabel="y"/>
    <graph at="f" function="f" stroke="blue"/>
    <legend anchor="(bbox[2], bbox[1])" alignment="nw">
      <item ref="f"><m>y =(2x)^2</m></item>
    </legend>
  </coordinates>
</diagram>