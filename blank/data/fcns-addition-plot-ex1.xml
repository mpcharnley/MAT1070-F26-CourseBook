<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> f(x)=2-sqrt(x+5) </definition>
  <definition> g(x)=x^2+x-2 </definition>
  <coordinates bbox="[-6,-6,6,6]">
    <grid-axes xlabel="x" ylabel="y"/>
    <graph function="f" stroke="blue"/>
    <graph function="g" stroke = "orange" />
  </coordinates>
</diagram>

