<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> f(x)=x^2 - 4*x</definition>
  <definition> g(x)=f(-1*x) </definition>
  <definition> h(x)=-1*f(x) </definition>
  <coordinates bbox="[-5, -5, 5, 5]">
    <grid-axes xlabel="x" ylabel="y"/>
    <graph at="f" function="f" stroke="blue"/>
    <graph at="g" function="g" stroke="red" dash="9 9"/>
    <graph at = "h" function="h" stroke="#a1842a" dash="2 4" thickness="3"/>
    <legend anchor="(bbox[0], bbox[3])" alignment="se">
      <item ref="f"><m>y =f(x)</m></item>
      <item ref="g"><m>y=f(-x)</m></item>
      <item ref="h"><m>y = -f(x)</m></item>
    </legend>
  </coordinates>
</diagram>