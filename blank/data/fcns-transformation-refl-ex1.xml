<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> f(x) = 4+x </definition>
  <definition> g(x) = (x-2)^2 </definition>
  <coordinates bbox="[-6,-6,6,6]">
    <grid-axes xlabel="x" ylabel="y"/>
    <graph function="f" stroke="blue" domain="[-6, 0]"/>
    <graph function="g" stroke="blue" domain="[0, 6]"/>
  </coordinates>
</diagram>