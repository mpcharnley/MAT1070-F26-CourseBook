<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> f(x,y)=x^2 - y^2 </definition>
  <coordinates bbox="[-6,-6,6,6]">
    <grid-axes xlabel="x" ylabel="y"/>
    <implicit-curve function="f" k="4" stroke="blue"/>
  </coordinates>
</diagram>

